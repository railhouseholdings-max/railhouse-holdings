# Local default: fictional portfolio data; calculator drafts are not saved.
RAILHOUSE_DATA_MODE=demo

# Set mode to supabase ONLY after migrations + owner setup.
# All variables below are server-only. Never use NEXT_PUBLIC_ for secrets.
# The publishable key is not privileged; row access still requires an owner JWT.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_OWNER_ID=
APP_ORIGIN=http://localhost:3000

# Optional Photon-compatible endpoint, server-side.
# Public Photon supports low-volume development, without an availability guarantee.
# Choose a suitable hosted endpoint before wider production use.
# ADDRESS_SEARCH_URL=https://photon.komoot.io/api/

# Server-only RentCast property records and long-term rental estimates.
RENTCAST_API_KEY=

# ARV result cache: disabled unless provider retention terms permit ephemeral caching.
# 0 (default) disables caching; maximum is 3600 seconds. Keys remain server-only.
RENTCAST_ARV_CACHE_SECONDS=0

# Scout only: unattended jobs use a dedicated server-side secret/service role key.
# Existing browser/user reads and writes continue to use owner JWT + RLS.
SCOUT_SUPABASE_SECRET_KEY=
# At least 32 random characters. Vercel cron sends this as its Bearer token.
CRON_SECRET=

# Daily Google Sheets feed import (server-only; share the sheet with this service account as Viewer).
# JSON key downloaded from Google Cloud; enable Google Sheets API in that project.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
SCOUT_GOOGLE_SHEET_ID=1pwGmqgLpAZ_WWqduYLaVDctTHcY4KiiTQXsyF5QroBw
SCOUT_GOOGLE_SHEET_GID=0
